{% if noteProps %}

<!-- Layout Matrix Generation Processing Engine -->
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function() {
    // 1. Hook the raw data bridge element generated by your FIRST plugin
    const bridge = document.getElementById('dg-frontmatter-to-html');
    if (!bridge) return;

    const m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const f = (s) => {
        if (!s) return '';
        const p = s.split(' ');
        const d = p[0].split('-');
        if (d.length < 3) return s;
        const yr = d[0], mo = m[parseInt(d[1],10)-1], dy = parseInt(d[2],10);
        if (p.length < 2) return `${yr} ${mo} ${dy}`;
        const t = p[1].split(':');
        if (t.length < 2) return `${yr} ${mo} ${dy}`;
        let h = parseInt(t[0],10), min = t[1], ampm='AM';
        if (h >= 12) { ampm = 'PM'; if (h > 12) h -= 12; }
        if (h === 0) h = 12;
        return `${yr} ${mo} ${dy} ${h}:${min} ${ampm}`;
    };

    const published = f(bridge.getAttribute('data-published'));
    const timeline = f(bridge.getAttribute('data-timeline'));
    const source = bridge.getAttribute('data-source');
    const categories = bridge.getAttribute('data-categories');
    const rawTags = bridge.getAttribute('data-tags');
    const nativeCreated = document.querySelector('.timestamps div:nth-child(1)')?.innerText?.replace(/[^0-9A-Za-z\s-:]/g, '').trim();
    const nativeUpdated = document.querySelector('.timestamps div:nth-child(2)')?.innerText?.replace(/[^0-9A-Za-z\s-:]/g, '').trim();

    // Line 1: Chronological Dates Matrix
    let line1 = '<div class="scb-meta-line">';
    if (timeline) line1 += `<div class="scb-meta-pill scb-pill-yellow"><span>📅</span><span style="opacity:0.6; margin-right:4px;">Event Timeline:</span><strong>${timeline}</strong></div>`;
    if (nativeCreated && !published) line1 += `<div class="scb-meta-pill scb-pill-yellow"><span>✏️</span><span style="opacity:0.6; margin-right:4px;">Created on:</span><strong>${nativeCreated}</strong></div>`;
    if (published) line1 += `<div class="scb-meta-pill"><span>🚀</span><span style="opacity:0.6; margin-right:4px;">Published on:</span><strong>${published}</strong></div>`;
    if (nativeUpdated) line1 += `<div class="scb-meta-pill scb-pill-blue"><span>🔄</span><span style="opacity:0.6; margin-right:4px;">Updated on:</span><strong>${nativeUpdated}</strong></div>`;
    line1 += '</div>';

    // Line 2: Origin Classification System
    let line2 = '<div class="scb-meta-line" style="margin-top: 6px;">';
    if (source) line2 += `<div class="scb-meta-pill"><span>📰</span><span style="opacity:0.6; margin-right:4px;">source:</span><strong>${source}</strong></div>`;
    if (categories) line2 += `<div class="scb-meta-pill"><span>📁</span><span style="opacity:0.6; margin-right:4px;">categories:</span><strong>${categories}</strong></div>`;
    line2 += '</div>';

    // Line 3: Isolated Interactive Green Hashtag Link Cells
    let line3 = '';
    if (rawTags) {
        line3 += '<div class="scb-meta-line" style="margin-top: 6px;">';
        const tagsArray = rawTags.split(',').map(t => t.trim());
        tagsArray.forEach(tag => {
            if (tag) {
                line3 += `<a href="/tags/${tag}" class="scb-meta-pill scb-tag-cell"><span>#${tag}</span></a>`;
            }
        });
        line3 += '</div>';
    }

    // Safely inject your beautifully styled rows directly into the data element container
    bridge.innerHTML = line1 + line2 + line3;
    bridge.style.display = 'flex';
    bridge.style.visibility = 'visible';
});
</script>
{% endif %}