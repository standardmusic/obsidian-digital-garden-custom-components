{% if settings.dgShowFileTree !== true %}
{% include "components/navbar.njk" %}
{% else %}
<div x-init="isDesktop = (window.innerWidth>=1000) ? true: false;"
  x-on:resize.window="isDesktop = (window.innerWidth>=1000) ? true : false;"
  x-data="{isDesktop: true, showFilesMobile: false}">

  <div x-show.important="!isDesktop" style="display: none;">
    <nav class="navbar">
      <div class="navbar-inner">
        <span style="font-size: 1.5rem; margin-right: 10px;" @click="showFilesMobile=!showFilesMobile"><i
            data-lucide="menu"></i></span>
        {% for imp in dynamics.filetree.beforeTitle %}
        {% include imp %}
        {% endfor %}
        {% if meta.siteLogoPath %}
        <a href="/" style="text-decoration: none; flex: 1; display: flex; justify-content: center;">
          <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
        </a>
        {% else %}
        <a href="/" style="text-decoration: none; text-align: center;">
          <h1 style="margin: 15px !important;">{{meta.siteName}}</h1>
        </a>
        {% endif %}
        {% for imp in dynamics.filetree.afterTitle %}
        {% include imp %}
        {% endfor %}
      </div>

      <div class="navbar-actions">
        {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
        {% include "components/pagePanelButton.njk" %}
      </div>
    </nav>
  </div>

  <div x-show="showFilesMobile && !isDesktop" @click="showFilesMobile = false" style="display:none;"
    class="fullpage-overlay"></div>

  <div class="filetree-wrapper" x-show.important="isDesktop || showFilesMobile" style="display: none;">
    <nav class="filetree-sidebar">
      {% for imp in dynamics.filetree.beforeTitle %}
      {% include imp %}
      {% endfor %}
      {% if meta.siteLogoPath %}
      <a href="/" style="text-decoration: none; display: flex; justify-content: center;">
        <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
      </a>
      {% else %}
      <a href="/" style="text-decoration: none; text-align: center;">
        <h1 style="text-align:center;">{{meta.siteName}}</h1>
      </a>
      {% endif %}
      {% for imp in dynamics.filetree.afterTitle %}
      {% include imp %}
      {% endfor %}
      {% set slotName = "filetree.actions" %}{% include "components/pluginSlot.njk" %}

      {#- The tree itself is rendered once to /filetree.html (see ../index.js) rather than into every page. -#}
      <div class="folder" x-data="{isOpen: true}">
        <div class="filetree-skeleton" aria-hidden="true">
          <div class="skeleton-line" style="width: 75%;"></div>
          <div class="skeleton-line" style="width: 60%;"></div>
          <div class="skeleton-line" style="width: 85%;"></div>
          <div class="skeleton-line" style="width: 50%;"></div>
          <div class="skeleton-line" style="width: 70%;"></div>
        </div>
        <noscript>
          <div class="notelink">
            <a class="filename" href="/filetree.html">Browse all notes</a>
          </div>
        </noscript>
      </div>

      <script>
        (function () {
          var root = document.currentScript.previousElementSibling;
          var trim = function (p) { return p.replace(/\/+$/, "") || "/"; };
          fetch("/filetree.html?v={{ meta.buildDate | isoDate }}")
            .then(function (res) {
              if (!res.ok) throw new Error("HTTP " + res.status);
              return res.text();
            })
            .then(function (html) {
              root.innerHTML = html;
              var here = trim(location.pathname);
              root.querySelectorAll("a.filename").forEach(function (a) {
                if (trim(new URL(a.getAttribute("href"), location.href).pathname) === here) {
                  a.parentElement.classList.add("active-note");
                }
              });
              // Icons in the tree arrive after lucideIcons.njk ran on DOMContentLoaded.
              if (window.lucide) lucide.createIcons({ attrs: { class: ["svg-icon"] } });
            })
            .catch(function (err) { console.warn("Could not load the file tree:", err); });
        })();
      </script>
    </nav>
  </div>
</div>
{% endif %}